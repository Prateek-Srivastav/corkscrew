DXVK_SOURCE_SHA256=4fe89134b661c1c3ead044004c73bcbf5a5c4987736c0912d05929e3fe839b8b

# D3DMetal for the engine pack: Apple's Game Porting Toolkit image, downloaded by hand from
# developer.apple.com (it needs an Apple Account). Its license allows non-commercial redistribution
# of the redist/ components with Apple's notices; package-engine.sh checks the image was this one.
GPTK_VERSION=3.0
GPTK_DMG_SHA256=ac8f6eeb2b9e5244d4c8eeb5b69b5cec099b560b143a7e5ef413945fc48b0f8f

MOLTENVK_VERSION=1.4.2
MOLTENVK_URL=https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-macos.tar
MOLTENVK_SHA256=f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e

# Versions the CrossOver 26.3.0 Wine expects (dlls/appwiz.cpl/addons.c).
WINE_MONO_VERSION=10.4.1
WINE_GECKO_VERSION=2.47.4
WINE_MONO_URL=https://dl.winehq.org/wine/wine-mono/10.4.1/wine-mono-10.4.1-x86.msi
WINE_MONO_SHA256=071f4b2887e1c97a11d791ff3d65be9429eed6dec4c2708888bfd546ba358e23

# x86_64 libraries for Wine. GMP comes from the CrossOver tarball; its Nettle has no generated
# configure, so use the same version's upstream release.
NETTLE_URL=https://ftp.gnu.org/gnu/nettle/nettle-3.10.tar.gz
NETTLE_SHA256=b4c518adb174e484cb4acea54118f02380c7133771e7e9beb98a0787194ee47c
SDL2_URL=https://github.com/libsdl-org/SDL/releases/download/release-2.32.10/SDL2-2.32.10.tar.gz
SDL2_SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165
# CrossOver's GnuTLS 3.8.3 tree only builds inside its own bundle, and 3.8.3 clashes with Nettle 3.10.
GNUTLS_URL=https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz
GNUTLS_SHA256=ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e
# CrossOver's FreeType is a git checkout without its dlg submodule; use the same version's release.
FREETYPE_URL=https://download.savannah.gnu.org/releases/freetype/freetype-2.13.3.tar.xz
FREETYPE_SHA256=0550350666d427c74daeb85d5ac7bb353acba5f76956395995311a9c6f063289
